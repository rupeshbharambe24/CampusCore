# apps/api/.env.example
# Copy to .env and fill in. Never commit .env.

# ---- App ----
ENVIRONMENT=local
DEBUG=true

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- CORS (comma-separated in env; parsed by pydantic) ----
# Accept the Next.js dev server by default
CORS_ORIGINS=["http://localhost:3000"]

# ---- Local Postgres ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campuscore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Supabase (Phase 1+ — leave blank for Phase 0) ----
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
