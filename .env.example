# Root-level shared env example. Copy to .env and fill in.
# App-specific envs live in apps/web/.env.local and apps/api/.env
# This root file is just for values shared across tools (e.g., local DB).

# Local Postgres (used by apps/api and pgAdmin)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=campuscore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
